<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
  <meta name="theme-color" content="#08051a">
  <title>Birthday Surprise ✦</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div id="stars"></div>
  <div class="aurora aurora-a"></div>
  <div class="aurora aurora-b"></div>
  <div class="vignette"></div>

  <main class="scene">
    <!-- 1. CAKE -->
    <section id="intro" class="screen active">
      <div class="eyebrow">✦ A LITTLE SURPRISE ✦</div>
      <h1>Happy<br><span>Birthday</span></h1>
      <p class="subtitle">Ada sesuatu yang ingin aku berikan untukmu.</p>

      <div class="cake-wrap" id="cake" role="button" tabindex="0" aria-label="Klik kue">
        <div class="cake-glow"></div>
        <div class="cake">
          <div class="candle c1"><i></i></div>
          <div class="candle c2"><i></i></div>
          <div class="candle c3"><i></i></div>
          <div class="icing"></div>
          <div class="layer top"></div>
          <div class="layer middle"></div>
          <div class="layer bottom"></div>
          <div class="plate"></div>
        </div>
        <div class="tap-hint"><span>✦</span> KLIK KUE INI <span>✦</span></div>
      </div>
    </section>

    <!-- 2. NAME -->
    <section id="nameScreen" class="screen">
      <div class="form-card">
        <div class="form-orbit"></div>
        <div class="form-icon">✦</div>
        <div class="eyebrow">STEP 01 / 02</div>
        <h2>Masukan<br><span>namamu</span></h2>
        <p>Tenang, nama ini cuma dipakai untuk membuat surat kejutanmu terasa lebih personal.</p>

        <div class="input-shell">
          <input id="nameInput" type="text" maxlength="40" autocomplete="off"
                 placeholder="Name" aria-label="Masukkan nama">
          <div class="input-glow"></div>
        </div>
        <button class="primary-btn" id="nameBtn">Send <span>→</span></button>
        <div class="mini-note">✦ hanya untuk surat ini ✦</div>
      </div>
    </section>

    <!-- 3. AGE -->
    <section id="ageScreen" class="screen">
      <div class="form-card age-card">
        <div class="form-orbit"></div>
        <div class="form-icon">♡</div>
        <div class="eyebrow">STEP 02 / 02</div>
        <h2>Masukan usiamu<br><span>sekarang</span></h2>
        <p>Satu angka kecil untuk membuat ucapan ini benar-benar milikmu.</p>

        <div class="age-picker" aria-label="Pilih usia">
          <button class="age-arrow" id="ageUp" aria-label="Tambah usia">⌃</button>
          <div class="age-number" id="ageValue">0</div>
          <button class="age-arrow" id="ageDown" aria-label="Kurangi usia">⌄</button>
        </div>

        <div class="age-limit">0 — 100 tahun</div>
        <button class="primary-btn" id="ageBtn">Lanjut <span>→</span></button>
      </div>
    </section>

    <!-- 4. ENVELOPE -->
    <section id="envelopeScreen" class="screen">
      <div class="burst-ring"></div>
      <div class="envelope-stage">
        <div class="personal-greeting" id="personalGreeting">Untukmu ✦</div>
        <div class="sparkle-field"></div>
        <div class="envelope" id="envelope">
          <div class="env-back"></div>
          <div class="env-front"></div>
          <div class="env-flap"></div>
          <div class="seal">♥</div>
          <div class="env-glow"></div>
        </div>
        <div class="floating-hearts">♥　✦　♥　✧　♥</div>
        <button class="primary-btn" id="openBtn">Buka surat <span>→</span></button>
      </div>
    </section>

    <!-- 5. LETTER -->
    <section id="letterScreen" class="screen">
      <div class="letter-wrap">
        <div class="letter-card">
          <div class="letter-top">✦ A LETTER FOR YOU ✦</div>
          <h2 id="letterTitle">Untuk seseorang<br>yang istimewa.</h2>
          <div class="line"></div>
          <p id="letterText"></p>
          <div class="signature">— dari seseorang yang mendoakanmu ♡</div>
          <button class="primary-btn small" id="finishBtn">Lanjutkan <span>→</span></button>
        </div>
      </div>
    </section>

    <!-- 6. FINAL -->
    <section id="finalScreen" class="screen">
      <div class="final-content">
        <div class="crown">♔</div>
        <div class="eyebrow">✦ TODAY IS YOUR DAY ✦</div>
        <h2>Selamat<br><span id="finalName">Ulang Tahun!</span></h2>
        <p id="finalText">Semoga langkahmu selalu dipenuhi hal-hal baik, orang-orang tulus, dan alasan baru untuk tersenyum.</p>
        <div class="wish-list">
          <div>♡ Semoga selalu bahagia</div>
          <div>✦ Semoga semua impianmu tercapai</div>
          <div>♡ Semoga dikelilingi orang-orang baik</div>
        </div>
        <button class="ghost-btn" id="replayBtn">↻ Putar lagi</button>
      </div>
    </section>
  </main>

  <canvas id="fx"></canvas>
  <div id="toast"></div>
  <script src="script.js"></script>
</body>
</html>
